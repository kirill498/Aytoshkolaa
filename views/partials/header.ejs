<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>
<body>

    <!-- ШАПКА САЙТА (одна на все страницы) -->
    <header class="header">
        <div class="header-wrapper">
            <a href="/" class="logo">
                <img src="/png/logo.png" alt="логотип автошколы">
            </a>

            <ul class="menu" id="menu">
                <li><a href="/" class="<%= active === 'home' ? 'active' : '' %>">Главная</a></li>
                <li><a href="/about" class="<%= active === 'about' ? 'active' : '' %>">О школе</a></li>
                <li><a href="/cars" class="<%= active === 'cars' ? 'active' : '' %>">Машины</a></li>
                <li><a href="/instructors" class="<%= active === 'instructors' ? 'active' : '' %>">Инструкторы</a></li>
                <li><a href="/contacts" class="<%= active === 'contacts' ? 'active' : '' %>">Контакты</a></li>
                <li><a href="/registration" class="<%= active === 'registration' ? 'active' : '' %>">Записаться</a></li>
            </ul>

            <button class="burger-btn" onclick="toggleMenu()">☰</button>
        </div>
    </header>
