<%- include('partials/header') %>
    <!-- ФОРМА ЗАПИСИ -->
    <section class="form-block">
        <form class="form-box" id="regForm" onsubmit="checkForm(event)">
            <h2>Записаться на курс</h2>

            <div class="form-group">
                <label for="userName">Ваше имя</label>
                <input type="text" id="userName" placeholder="Как вас зовут?">
                <div class="form-error" id="nameError"></div>
            </div>

            <div class="form-group">
                <label for="userPhone">Телефон</label>
                <input type="tel" id="userPhone" placeholder="+7 900 000-00-00">
                <div class="form-error" id="phoneError"></div>
            </div>

            <div class="form-group">
                <label>Простая проверка: сколько будет <span id="num1"></span> + <span id="num2"></span> ?</label>
                <input type="text" id="captchaInput" placeholder="Ваш ответ">
                <div class="form-error" id="captchaError"></div>
            </div>

            <div class="form-error" id="serverError"></div>

            <button type="submit" class="btn">Записаться</button>

            <div class="form-success" id="successBlock" style="display:none;">
                Спасибо! Мы вам скоро перезвоним.
            </div>
        </form>
    </section>

<%- include('partials/footer') %>
