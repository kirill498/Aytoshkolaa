<%- include('partials/header') %>
    <!-- ФОРМА ВХОДА В АДМИНКУ -->
    <section class="form-block" id="loginBlock">
        <form class="form-box" onsubmit="checkLogin()">
            <h2>Вход для администратора</h2>

            <div class="form-group">
                <label for="adminLogin">Логин</label>
                <input type="text" id="adminLogin" placeholder="admin">
            </div>

            <div class="form-group">
                <label for="adminPassword">Пароль</label>
                <input type="password" id="adminPassword" placeholder="пароль">
            </div>

            <div class="form-error" id="loginError"></div>

            <button type="submit" class="btn">Войти</button>
            <p class="admin-hint">Для теста: admin / 1234</p>
        </form>
    </section>

    <!-- ПАНЕЛЬ С ЗАЯВКАМИ, СНАЧАЛА СКРЫТА -->
    <section class="page-content" id="panelBlock" style="display:none;">
        <h1>Заявки на обучение</h1>
        <div id="zayavkiPlace"></div>
        <button class="btn btn-dark" onclick="logoutAdmin()">Выйти</button>
    </section>

<%- include('partials/footer') %>
